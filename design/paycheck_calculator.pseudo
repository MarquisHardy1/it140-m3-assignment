START

LET regularRate = 20
LET overtimeRate = 30
INPUT hoursWorked
IF hoursWorked <= 40 THEN
    LET paycheck = hoursWorked * regularRate
ELSE
    LET regularPay = 40 * regularRate
    LET overtimeHours = hoursWorked - 40
    LET overtimePay = overtimeHours * overtimeRate
    LET paycheck = regularPay + overtimePay
END IF
OUTPUT paycheck
